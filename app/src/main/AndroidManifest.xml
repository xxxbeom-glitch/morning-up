<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 수면 라운지는 MVP에서 숨겨요(결정 140, 141). core/alarm의 잠들기 재생 서비스와 권한 선언을 빼요.
         되살릴 때는 아래 두 줄을 지우고 app/build.gradle.kts의 SLEEP_LOUNGE를 true로 해요. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:node="remove" />

    <application
        android:name=".MorningUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="${appIcon}"
        android:label="@string/app_name"
        android:roundIcon="${appRoundIcon}"
        android:supportsRtl="true"
        android:theme="@style/Theme.MorningUp">

        <service
            android:name="com.lumian.morningup.core.alarm.sleep.SleepPlaybackService"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 울림 화면(D0, M, W1, W2). 잠금 화면 위에 뜨고, 잠금을 풀기 전(재부팅 직후)에도 열려요. -->
        <activity
            android:name=".ring.RingActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.lumian.morningup.ring"
            android:turnScreenOn="true" />
    </application>

</manifest>
