<?xml version="1.0" encoding="utf-8"?>
<!--
  안드로이드 12 이상 자동 백업 규칙 (F11).
  알람은 기기 보호 저장소(잠금 전에도 열리는 칸)에 있어서 device_* 영역을 넣어요.
  넣을 파일만 적어서, 울리는 중 상태와 진단 기록처럼 그 폰에만 맞는 값은 따라가지 않아요.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_database" path="morningup.db" />
        <include domain="device_file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_database" path="morningup.db" />
        <include domain="device_file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
